# Spotify OAuth — create an app at https://developer.spotify.com/dashboard
# Copy to .env and fill in values (never commit .env).
#
# Interactive runs: repo .env or shell exports are fine.
# Login autostart: copy this file to the per-user config directory, e.g.
#   Windows: %APPDATA%\now-playing-desktops\.env
#   macOS:   ~/Library/Application Support/now-playing-desktops/.env
#   Linux:   ~/.config/now-playing-desktops/.env
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
# Optional; must match a redirect URI in your Spotify app settings.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8897/callback
# Optional but recommended for autostart (OAuth token cache username).
SPOTIPY_CLIENT_USERNAME=your_spotify_username
